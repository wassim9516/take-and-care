# Copie ce fichier en .env (non commité) pour le développement local.
# URL du backend : IP du Mac sur le Wi-Fi (ifconfig | grep "inet 192")
EXPO_PUBLIC_API_URL=http://192.168.1.XX:3000/api

# Clé publique Stripe — laisser vide dans Expo Go (Stripe nécessite un build EAS)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Adresse affichée dans « Contacter le support »
EXPO_PUBLIC_SUPPORT_EMAIL=support@takeandcare.fr

# Builds EAS uniquement (définies dans les variables d'environnement EAS) :
# EAS_PROJECT_ID=          → npx eas init
# GOOGLE_MAPS_API_KEY=     → carte sur Android
