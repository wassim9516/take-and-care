{
  "expo": {
    "name": "Take & Care",
    "slug": "pharmasave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.takeandcare.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2ECC71"
      },
      "package": "fr.takeandcare.app"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Take & Care a besoin de ta position pour trouver les pharmacies près de toi."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.fr.takeandcare.app",
          "enableGooglePay": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-secure-store"
    ]
  }
}
