# ============================================================
# .env.example — Copie ce fichier en .env et remplis les valeurs
#   cp .env.example .env
# Ne commite JAMAIS le fichier .env
# ============================================================

# Connexion PostgreSQL (développement local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmasave
DB_USER=
DB_PASSWORD=

# En production (Railway) : URL complète, remplace les DB_* ci-dessus
# DATABASE_URL=

# Clé secrète des tokens JWT — génère-la avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port du serveur
PORT=3000

# URL publique du serveur (IP locale en dev, URL Railway en prod)
BACKEND_URL=http://192.168.1.XX:3000

# URL du dashboard (redirections Stripe)
FRONTEND_URL=http://localhost:3001

# Origines autorisées par CORS en production, séparées par des virgules
# CORS_ORIGINS=https://mon-dashboard.example.com

# Mot de passe des comptes pharmaciens créés par database/seed.js
# (vide = mot de passe aléatoire affiché dans la console)
SEED_PASSWORD=

# Stripe — laisser vide pour désactiver les paiements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COMMISSION_TAUX=0.10

# Twilio — laisser vide : les codes SMS s'affichent dans la console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
